# EmailJS — used by the contact form (src/app/contact/page.tsx).
# Create a free account at https://www.emailjs.com/ and copy the values from your dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Generative AI API Key — used by Vercel AI SDK for Gemini API access.
# Get your key from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
